<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: white with a near-black outline so you know where you're typing -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_white" />
            <stroke android:width="1.5dp" android:color="@color/text_primary" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
    <!-- Resting: soft grey surface with a hairline divider -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_primary" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:radius="@dimen/radius_input" />
        </shape>
    </item>
</selector>