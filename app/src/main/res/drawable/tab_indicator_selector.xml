<?xml version="1.0" encoding="utf-8"?>
<!-- Page indicator: the CURRENT page is a wide pill, the others are small faded dots.
     A selector picks the first matching <item>, so the "selected" item must come first.
     Each layer-list centres a fixed-size shape inside the tab and adds 4dp either side
     as spacing between indicators. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected page: 24 x 8dp pill -->
    <item android:state_selected="true">
        <layer-list>
            <item
                android:width="24dp"
                android:height="8dp"
                android:left="4dp"
                android:right="4dp"
                android:gravity="center">
                <shape android:shape="rectangle">
                    <solid android:color="@color/onboarding_dot_selected" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Every other page: 8dp dot -->
    <item>
        <layer-list>
            <item
                android:width="8dp"
                android:height="8dp"
                android:left="4dp"
                android:right="4dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/onboarding_dot_default" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>