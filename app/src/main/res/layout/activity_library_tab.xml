<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".LibraryTab.LibraryTabActivity">

    <!-- Scrollable Feature -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLibrary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_lg">

            <!-- ===================== HEADER ===================== -->

            <TextView
                android:id="@+id/txtViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:text="@string/app_title"
                android:textAppearance="@style/TextAppearance.App.Display"
                app:layout_constraintBottom_toBottomOf="@id/imgNotifications"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgNotifications" />

            <ImageButton
                android:id="@+id/imgNotifications"
                style="@style/Widget.App.IconButton.Light"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_margin"
                android:contentDescription="@string/lib_notifications"
                android:src="@drawable/ic_notifications"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgLibrary"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_circle_icon_light"
                android:contentDescription="@string/lib_title"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_library"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgNotifications"
                app:tint="@color/icon_dark" />

            <TextView
                android:id="@+id/txtViewLibrary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/lib_title"
                android:textAppearance="@style/TextAppearance.App.Headline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgLibrary"
                app:layout_constraintTop_toTopOf="@id/imgLibrary" />

            <TextView
                android:id="@+id/txtViewLibraryDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/lib_subtitle"
                android:textAppearance="@style/TextAppearance.App.Body"
                app:layout_constraintEnd_toEndOf="@id/txtViewLibrary"
                app:layout_constraintStart_toStartOf="@id/txtViewLibrary"
                app:layout_constraintTop_toBottomOf="@id/txtViewLibrary" />

            <!-- Sits below the lowest header view so a wrapped description can't collide with search -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgLibrary,txtViewLibraryDescription" />

            <!-- ===================== SEARCH ===================== -->
            <!-- A plain EditText (same id as before): Java only needs an EditText.
                 The look comes from the theme's editTextStyle. -->
            <EditText
                android:id="@+id/editTxtTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_margin"
                android:drawableStart="@drawable/ic_search"
                android:hint="@string/lib_search_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierHeader" />

            <!-- ===================== OVERVIEW ===================== -->

            <TextView
                android:id="@+id/txtViewLibraryOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/lib_overview"
                android:textAppearance="@style/TextAppearance.App.Section"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/editTxtTxt" />

            <!-- Three equal tiles. 16dp row margin + 8dp tile margin = 24dp, the screen margin.
                 Padding sits on the number and label (not the tile), so almost the whole
                 tile is tappable: Java attaches the click listener to those two views. -->
            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/space_md"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewLibraryOverview">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/editTxtNumberBorrowed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingTop="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="2dp"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.App.Value"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/txtViewBorrowed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md"
                            android:text="@string/lib_borrowed"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/editTxtNumberPending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingTop="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="2dp"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.App.Value"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/txtViewPending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md"
                            android:text="@string/lib_pending"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/editTxtNumberOverdue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingTop="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="2dp"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.App.Value"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/txtViewOverdue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md"
                            android:paddingBottom="@dimen/space_md"
                            android:text="@string/lib_overdue"
                            android:textAppearance="@style/TextAppearance.App.Body"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===================== SERVICES ===================== -->

            <TextView
                android:id="@+id/txtViewLibraryServices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/lib_services"
                android:textAppearance="@style/TextAppearance.App.Section"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/statsRow" />

            <!-- Row 1: Find a book -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFindBook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewLibraryServices">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgFindBook"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/space_md"
                        android:background="@drawable/bg_circle_icon_light"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_search"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_dark" />

                    <TextView
                        android:id="@+id/txtViewFindBook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/lib_find_book"
                        android:textAppearance="@style/TextAppearance.App.CardTitle"
                        app:layout_constraintBottom_toTopOf="@id/txtViewFindBookDescription"
                        app:layout_constraintEnd_toStartOf="@id/imgFindBookArrow"
                        app:layout_constraintStart_toEndOf="@id/imgFindBook"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtViewFindBookDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_md"
                        android:text="@string/lib_find_book_desc"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtViewFindBook"
                        app:layout_constraintStart_toStartOf="@id/txtViewFindBook"
                        app:layout_constraintTop_toBottomOf="@id/txtViewFindBook" />

                    <ImageView
                        android:id="@+id/imgFindBookArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/space_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_forward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_muted" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row 2: Request a book -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRequestBook"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardFindBook">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgRequestBook"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/space_md"
                        android:background="@drawable/bg_circle_icon_light"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_requestbook"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_dark" />

                    <TextView
                        android:id="@+id/txtViewRequestBook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/lib_request_book"
                        android:textAppearance="@style/TextAppearance.App.CardTitle"
                        app:layout_constraintBottom_toTopOf="@id/txtViewRequestBookDescription"
                        app:layout_constraintEnd_toStartOf="@id/imgRequestBookArrow"
                        app:layout_constraintStart_toEndOf="@id/imgRequestBook"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtViewRequestBookDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_md"
                        android:text="@string/lib_request_book_desc"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtViewRequestBook"
                        app:layout_constraintStart_toStartOf="@id/txtViewRequestBook"
                        app:layout_constraintTop_toBottomOf="@id/txtViewRequestBook" />

                    <ImageView
                        android:id="@+id/imgRequestBookArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/space_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_forward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_muted" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row 3: My requests -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardRequestBook">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgRequests"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/space_md"
                        android:background="@drawable/bg_circle_icon_light"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_requestedbooks"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_dark" />

                    <TextView
                        android:id="@+id/txtViewRequests"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/lib_my_requests"
                        android:textAppearance="@style/TextAppearance.App.CardTitle"
                        app:layout_constraintBottom_toTopOf="@id/txtViewRequestsDescription"
                        app:layout_constraintEnd_toStartOf="@id/imgRequestsArrow"
                        app:layout_constraintStart_toEndOf="@id/imgRequests"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtViewRequestsDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_md"
                        android:text="@string/lib_my_requests_desc"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtViewRequests"
                        app:layout_constraintStart_toStartOf="@id/txtViewRequests"
                        app:layout_constraintTop_toBottomOf="@id/txtViewRequests" />

                    <ImageView
                        android:id="@+id/imgRequestsArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/space_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_forward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_muted" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Row 4: Borrowed books -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBorrowedBooks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardRequests">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgBorrowedBooks"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="@dimen/space_md"
                        android:background="@drawable/bg_circle_icon_light"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_borrowedbooks"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_dark" />

                    <TextView
                        android:id="@+id/txtViewBorrowedBooks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginTop="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/lib_borrowed_books"
                        android:textAppearance="@style/TextAppearance.App.CardTitle"
                        app:layout_constraintBottom_toTopOf="@id/txtViewBorrowedBooksDescription"
                        app:layout_constraintEnd_toStartOf="@id/imgBorrowedBooksArrow"
                        app:layout_constraintStart_toEndOf="@id/imgBorrowedBooks"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtViewBorrowedBooksDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:layout_marginBottom="@dimen/space_md"
                        android:text="@string/lib_borrowed_books_desc"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtViewBorrowedBooks"
                        app:layout_constraintStart_toStartOf="@id/txtViewBorrowedBooks"
                        app:layout_constraintTop_toBottomOf="@id/txtViewBorrowedBooks" />

                    <ImageView
                        android:id="@+id/imgBorrowedBooksArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/space_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_forward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/text_muted" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BOTTOM NAV ===================== -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>