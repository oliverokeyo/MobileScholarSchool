<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeTab.HomeActivity">

    <TextView
        android:id="@+id/txtViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:text="@string/app_title"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgStudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_student"
        android:contentDescription="Student profile"
        app:tint="@color/icon_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtViewTitle" />

    <TextView
        android:id="@+id/txtViewWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        tools:text="Good Morning! John"
        app:layout_constraintStart_toEndOf="@id/imgStudent"
        app:layout_constraintEnd_toStartOf="@id/imgNotifications"
        app:layout_constraintTop_toTopOf="@id/imgStudent" />

    <TextView
        android:id="@+id/txtViewStudentID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Student ID:(SB06/SR/1234/90) "
        app:layout_constraintStart_toStartOf="@id/txtViewWelcome"
        app:layout_constraintTop_toBottomOf="@id/txtViewWelcome" />

    <ImageButton
        android:id="@+id/imgNotifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_notifications"
        android:contentDescription="Notifications"
        app:tint="@color/icon_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgStudent"
        app:layout_constraintBottom_toBottomOf="@id/imgStudent" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgStudent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />


    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierRow1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="imgPayments,txtViewBalance,imgLibrary,txtViewLibraryUpdates" />

    <TextView
        android:id="@+id/txtViewStudentOverview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="Student Overview"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <!-- Row 1, left: Fees -->
    <ImageView
        android:id="@+id/imgPayments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_payments"
        android:importantForAccessibility="no"
        app:tint="@color/icon_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtViewStudentOverview" />

    <TextView
        android:id="@+id/txtViewFeeBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Outstanding Fee Balance"
        app:layout_constraintStart_toEndOf="@id/imgPayments"
        app:layout_constraintEnd_toStartOf="@id/guideCenter"
        app:layout_constraintTop_toTopOf="@id/imgPayments" />

    <TextView
        android:id="@+id/txtViewBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ksh. [Balance]"
        app:layout_constraintStart_toStartOf="@id/txtViewFeeBalance"
        app:layout_constraintEnd_toEndOf="@id/txtViewFeeBalance"
        app:layout_constraintTop_toBottomOf="@id/txtViewFeeBalance" />

    <!-- Row 1, right: Library -->
    <ImageView
        android:id="@+id/imgLibrary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_library"
        android:importantForAccessibility="no"
        app:tint="@color/icon_dark"
        app:layout_constraintStart_toStartOf="@id/guideCenter"
        app:layout_constraintTop_toTopOf="@id/imgPayments" />

    <TextView
        android:id="@+id/textViewLibrary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        android:text="Library Updates"
        app:layout_constraintStart_toEndOf="@id/imgLibrary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgLibrary" />

    <TextView
        android:id="@+id/txtViewLibraryUpdates"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="(Updates)"
        app:layout_constraintStart_toStartOf="@id/textViewLibrary"
        app:layout_constraintEnd_toEndOf="@id/textViewLibrary"
        app:layout_constraintTop_toBottomOf="@id/textViewLibrary" />

    <!-- Row 2, left: Hostel -->
    <ImageView
        android:id="@+id/imgHostel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_hostel"
        android:importantForAccessibility="no"
        app:tint="@color/icon_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierRow1" />

    <TextView
        android:id="@+id/txtViewHostel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Hostel Updates"
        app:layout_constraintStart_toEndOf="@id/imgHostel"
        app:layout_constraintEnd_toStartOf="@id/guideCenter"
        app:layout_constraintTop_toTopOf="@id/imgHostel" />

    <TextView
        android:id="@+id/txtViewBookedStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="(Booked/Unbooked)"
        app:layout_constraintStart_toStartOf="@id/txtViewHostel"
        app:layout_constraintEnd_toEndOf="@id/txtViewHostel"
        app:layout_constraintTop_toBottomOf="@id/txtViewHostel" />

    <!-- Row 2, right: Units -->
    <ImageView
        android:id="@+id/imgUnits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_units"
        android:importantForAccessibility="no"
        app:tint="@color/icon_dark"
        app:layout_constraintStart_toStartOf="@id/guideCenter"
        app:layout_constraintTop_toTopOf="@id/imgHostel" />

    <TextView
        android:id="@+id/textViewUnits"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        android:text="Unit Registration"
        app:layout_constraintStart_toEndOf="@id/imgUnits"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgUnits" />

    <TextView
        android:id="@+id/textViewUnitStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="(Registered/Pending/Unregistered)"
        app:layout_constraintStart_toStartOf="@id/textViewUnits"
        app:layout_constraintEnd_toEndOf="@id/textViewUnits"
        app:layout_constraintTop_toBottomOf="@id/textViewUnits" />

    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>