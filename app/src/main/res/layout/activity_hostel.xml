<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HostelTab.HostelActivity">

    <!-- Scrollable Feature -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLibrary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <!-- NestedScrollView allows ONLY ONE child, so everything lives in this container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentHostel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- ===================== HEADER ===================== -->

            <TextView
                android:id="@+id/txtViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/app_title"
                android:textSize="36sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgHostel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_hostel"
                android:contentDescription="Student Hostels"
                app:tint="@color/icon_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewTitle" />

            <TextView
                android:id="@+id/txtViewWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Find accommodation that suits you."
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/imgHostel"
                app:layout_constraintEnd_toStartOf="@id/imgNotifications"
                app:layout_constraintTop_toTopOf="@id/imgHostel" />

            <TextView
                android:id="@+id/txtViewStudentID"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Student ID:(SB06/SR/1234/90)"
                app:layout_constraintStart_toStartOf="@id/txtViewWelcome"
                app:layout_constraintEnd_toEndOf="@id/txtViewWelcome"
                app:layout_constraintTop_toBottomOf="@id/txtViewWelcome" />

            <ImageButton
                android:id="@+id/imgNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="24dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_notifications"
                android:contentDescription="Notifications"
                app:tint="@color/icon_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgHostel"
                app:layout_constraintBottom_toBottomOf="@id/imgHostel" />

            <!-- Sits under the LOWEST of the three header views, so the search box can never overlap them -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgHostel,txtViewStudentID,imgNotifications" />

            <!-- ===================== SEARCH ===================== -->

            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:src="@drawable/ic_search"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/txtInputSearchHostel"
                app:layout_constraintBottom_toBottomOf="@id/txtInputSearchHostel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/txtInputSearchHostel"
                style="?attr/textInputOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                android:hint="Search hostel by name or location"
                app:layout_constraintStart_toEndOf="@id/imgSearch"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierHeader">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTxtTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===================== OVERVIEW ===================== -->

            <TextView
                android:id="@+id/txtViewHostelOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="My Accommodation"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtInputSearchHostel" />

            <TextView
                android:id="@+id/txtViewStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                android:text="Booking status"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewHostelOverview" />

            <!-- Placeholder: set this from code ("No active booking" or the hostel name) -->
            <TextView
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No active booking"
                app:layout_constraintStart_toStartOf="@id/txtViewStatus"
                app:layout_constraintEnd_toEndOf="@id/txtViewStatus"
                app:layout_constraintTop_toBottomOf="@id/txtViewStatus" />

            <!-- ===================== FIND ACCOMMODATION ===================== -->

            <TextView
                android:id="@+id/txtViewAccomodation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Find Accommodation"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textView2" />

            <!-- Row 1: Hostel Location -->
            <ImageView
                android:id="@+id/imgLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_location"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewAccomodation" />

            <TextView
                android:id="@+id/txtViewLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Hostel Location"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/imgLocation"
                app:layout_constraintEnd_toStartOf="@id/imgLocationArrow"
                app:layout_constraintTop_toTopOf="@id/imgLocation" />

            <TextView
                android:id="@+id/txtViewLocationDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose campus, nearby or off-campus accommodation."
                app:layout_constraintStart_toStartOf="@id/txtViewLocation"
                app:layout_constraintEnd_toEndOf="@id/txtViewLocation"
                app:layout_constraintTop_toBottomOf="@id/txtViewLocation" />

            <ImageView
                android:id="@+id/imgLocationArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_forward"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgLocation"
                app:layout_constraintBottom_toBottomOf="@id/imgLocation" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgLocation,txtViewLocationDescription,imgLocationArrow" />

            <View
                android:id="@+id/divider1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierLocation" />

            <!-- Row 2: Sharing Preference -->
            <ImageView
                android:id="@+id/imgPreference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_preference"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider1" />

            <TextView
                android:id="@+id/txtViewPreferance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Sharing Preference"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/imgPreference"
                app:layout_constraintEnd_toStartOf="@id/imgPreferenceArrow"
                app:layout_constraintTop_toTopOf="@id/imgPreference" />

            <TextView
                android:id="@+id/textViewPreferenceDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose private or shared accommodation."
                app:layout_constraintStart_toStartOf="@id/txtViewPreferance"
                app:layout_constraintEnd_toEndOf="@id/txtViewPreferance"
                app:layout_constraintTop_toBottomOf="@id/txtViewPreferance" />

            <ImageView
                android:id="@+id/imgPreferenceArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_forward"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/txtViewPreferance"
                app:layout_constraintBottom_toBottomOf="@id/textViewPreferenceDescription" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierPreference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgPreference,txtViewPreferance,textViewPreferenceDescription,imgPreferenceArrow" />

            <View
                android:id="@+id/divider2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierPreference" />

            <!-- Row 3: Room Type -->
            <ImageView
                android:id="@+id/imgRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_hostel"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider2" />

            <TextView
                android:id="@+id/txtViewRoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Room Type"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/imgRoom"
                app:layout_constraintEnd_toStartOf="@id/imgRoomArrow"
                app:layout_constraintTop_toTopOf="@id/imgRoom" />

            <TextView
                android:id="@+id/txtViewRoomDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bedsitter, single room, one-bedroom or shared room."
                app:layout_constraintStart_toStartOf="@id/txtViewRoom"
                app:layout_constraintEnd_toEndOf="@id/txtViewRoom"
                app:layout_constraintTop_toBottomOf="@id/txtViewRoom" />

            <ImageView
                android:id="@+id/imgRoomArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_forward"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgRoom"
                app:layout_constraintBottom_toBottomOf="@id/imgRoom" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgRoom,txtViewRoomDescription,imgRoomArrow" />

            <View
                android:id="@+id/divider3"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="?android:attr/listDivider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierRoom" />

            <!-- Row 4: Budget -->
            <ImageView
                android:id="@+id/imgBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_payments"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider3" />

            <TextView
                android:id="@+id/txtViewBudget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="Budget"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/imgBudget"
                app:layout_constraintEnd_toStartOf="@id/imgBudgetArrow"
                app:layout_constraintTop_toTopOf="@id/imgBudget" />

            <TextView
                android:id="@+id/textViewBudgetDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Compare rent and available facilities."
                app:layout_constraintStart_toStartOf="@id/txtViewBudget"
                app:layout_constraintEnd_toEndOf="@id/txtViewBudget"
                app:layout_constraintTop_toBottomOf="@id/txtViewBudget" />

            <ImageView
                android:id="@+id/imgBudgetArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:src="@drawable/ic_forward"
                android:importantForAccessibility="no"
                app:tint="@color/icon_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgBudget"
                app:layout_constraintBottom_toBottomOf="@id/imgBudget" />

            <!-- Same style as your other barriers: sits under the lowest part of the Budget row -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierBudget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgBudget,textViewBudgetDescription,imgBudgetArrow" />

            <!-- Search: lists the hostels that fit the four choices above (Hostel Search Result) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchHostels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:text="Search hostels"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/barrierBudget" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BOTTOM NAV ===================== -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>