<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".PaymentsTab.PaymentActivity">

    <!-- Scrollable area: sits between the top of the screen and the bottom nav -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLibrary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- NestedScrollView allows ONLY ONE child, so everything lives in this container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentHostel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_lg">

            <!-- ===================== HEADER ===================== -->

            <TextView
                android:id="@+id/txtViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:text="@string/app_title"
                android:textAppearance="@style/TextAppearance.App.Display"
                app:layout_constraintBottom_toBottomOf="@id/imgNotifications"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgNotifications" />

            <ImageButton
                android:id="@+id/imgNotifications"
                style="@style/Widget.App.IconButton.Light"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_margin"
                android:contentDescription="@string/cd_notifications"
                android:src="@drawable/ic_notifications"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgPayments"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_circle_icon_light"
                android:contentDescription="@string/cd_payments_icon"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_payments"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgNotifications"
                app:tint="@color/icon_dark" />

            <TextView
                android:id="@+id/txtViewWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/payments_welcome"
                android:textAppearance="@style/TextAppearance.App.Section"
                app:layout_constraintBottom_toBottomOf="@id/imgPayments"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgPayments"
                app:layout_constraintTop_toTopOf="@id/imgPayments" />

            <!-- Sits below the LOWEST header view, so nothing can overlap it
                 even when the welcome text wraps onto extra lines -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/headerBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgPayments,txtViewWelcome,imgNotifications" />

            <!-- Status shown as a small grey pill -->
            <TextView
                android:id="@+id/txtViewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_chip"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/registration_status_default"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headerBarrier" />

            <!-- ===================== PAYMENT FORM ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewStatus">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/formContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_lg">

                    <!-- Form title -->
                    <TextView
                        android:id="@+id/txtViewMakePayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/make_a_payment"
                        android:textAppearance="@style/TextAppearance.App.Section"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Student number (look comes from the theme's editTextStyle) -->
                    <TextView
                        android:id="@+id/txtViewStudentNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:labelFor="@id/editTxtTxtStudentNo"
                        android:text="@string/label_student_number"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtViewMakePayment" />

                    <EditText
                        android:id="@+id/editTxtTxtStudentNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:autofillHints="username"
                        android:hint="@string/hint_student_number"
                        android:imeOptions="actionNext"
                        android:inputType="textCapCharacters"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtViewStudentNo" />

                    <!-- Amount -->
                    <TextView
                        android:id="@+id/txtViewAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:labelFor="@id/editTxtNumberAmount"
                        android:text="@string/label_amount"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/editTxtTxtStudentNo" />

                    <EditText
                        android:id="@+id/editTxtNumberAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:hint="@string/hint_amount"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/txtViewAmount" />

                    <!-- Phone number -->
                    <TextView
                        android:id="@+id/textViewPhoneNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:labelFor="@id/editTxtNumberPhoneNo"
                        android:text="@string/label_phone"
                        android:textAppearance="@style/TextAppearance.App.Label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/editTxtNumberAmount" />

                    <EditText
                        android:id="@+id/editTxtNumberPhoneNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:autofillHints="phone"
                        android:hint="@string/hint_phone"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/textViewPhoneNo" />

                    <!-- Primary pill button, full width of the form -->
                    <Button
                        android:id="@+id/btnPayment"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/btn_continue_pay"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/editTxtNumberPhoneNo" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== RECENT TRANSACTIONS ===================== -->

            <TextView
                android:id="@+id/txtViewRecentTransactions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/recent_transactions"
                android:textAppearance="@style/TextAppearance.App.Headline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPaymentForm" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTransactions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewRecentTransactions">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:id="@+id/imgReceipt"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_icon_light"
                        android:contentDescription="@string/cd_receipt_icon"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_receipt"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_dark" />

                    <!-- Title + description form a packed chain: centred beside the icon -->
                    <TextView
                        android:id="@+id/txtViewTransactionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/transaction_title"
                        android:textAppearance="@style/TextAppearance.App.CardTitle"
                        app:layout_constraintBottom_toTopOf="@id/txtViewTransactionDesc"
                        app:layout_constraintEnd_toStartOf="@id/imgForward"
                        app:layout_constraintStart_toEndOf="@id/imgReceipt"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtViewTransactionDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/transaction_desc"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtViewTransactionTitle"
                        app:layout_constraintStart_toStartOf="@id/txtViewTransactionTitle"
                        app:layout_constraintTop_toBottomOf="@id/txtViewTransactionTitle" />

                    <ImageButton
                        android:id="@+id/imgForward"
                        style="@style/Widget.App.IconButton.Light"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/cd_view_transaction"
                        android:src="@drawable/ic_forward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== STUDENT REGISTRATION ===================== -->

            <TextView
                android:id="@+id/txtViewStudentRegistration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/student_registration"
                android:textAppearance="@style/TextAppearance.App.Headline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardTransactions" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegistration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtViewStudentRegistration">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_md">

                    <ImageView
                        android:id="@+id/imgPrint"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_icon_light"
                        android:contentDescription="@string/cd_print_icon"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_print"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/icon_dark" />

                    <TextView
                        android:id="@+id/txtViewPrintTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:text="@string/print_registration_title"
                        android:textAppearance="@style/TextAppearance.App.CardTitle"
                        app:layout_constraintBottom_toTopOf="@id/txtViewPrintDesc"
                        app:layout_constraintEnd_toStartOf="@id/imgForwardPrint"
                        app:layout_constraintStart_toEndOf="@id/imgPrint"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtViewPrintDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/print_registration_desc"
                        android:textAppearance="@style/TextAppearance.App.Body"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtViewPrintTitle"
                        app:layout_constraintStart_toStartOf="@id/txtViewPrintTitle"
                        app:layout_constraintTop_toBottomOf="@id/txtViewPrintTitle" />

                    <ImageButton
                        android:id="@+id/imgForwardPrint"
                        style="@style/Widget.App.IconButton.Light"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/cd_print_registration"
                        android:src="@drawable/ic_forward"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== BOTTOM NAV ===================== -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>