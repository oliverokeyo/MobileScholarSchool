<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated with the Activity's inflater, so the theme's editTextStyle and spinnerStyle apply here too -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm">

        <EditText
            android:id="@+id/dlgFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:drawableStart="@drawable/ic_name"
            android:hint="@string/hint_full_name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/dlgIdNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:drawableStart="@drawable/ic_idnumber"
            android:hint="@string/hint_id_number"
            android:importantForAutofill="no"
            android:inputType="number" />

        <EditText
            android:id="@+id/dlgRegNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:drawableStart="@drawable/ic_regnumber"
            android:hint="@string/hint_registration_no"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/label_gender"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <RadioGroup
            android:id="@+id/dlgGenderGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/dlgMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender_male"
                android:textAppearance="@style/TextAppearance.App.Body" />

            <RadioButton
                android:id="@+id/dlgFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_lg"
                android:text="@string/gender_female"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </RadioGroup>

        <!-- Course drop down. Uses the same course_list array as the Sign Up
             screen, so the two screens always offer exactly the same choices. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/label_course"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <Spinner
            android:id="@+id/dlgCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:entries="@array/course_list" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/label_department"
            android:textAppearance="@style/TextAppearance.App.Label" />

        <Spinner
            android:id="@+id/dlgDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:entries="@array/department_list" />
    </LinearLayout>
</ScrollView>