<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= TYPOGRAPHY (system font) =================
         No custom font files. Weights come from the device's own font:
         regular = default, light/medium = sans-serif-light / sans-serif-medium,
         bold = textStyle bold. -->

    <!-- Main page headings: large, bold, near-black -->
    <style name="TextAppearance.App.Display" parent="android:TextAppearance">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- Section headings: medium weight -->
    <style name="TextAppearance.App.Headline" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Section" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Card titles: medium weight -->
    <style name="TextAppearance.App.CardTitle" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Form labels (Gender, Course, ...): small, medium weight -->
    <style name="TextAppearance.App.Label" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Important values and prices: bold -->
    <style name="TextAppearance.App.Value" parent="android:TextAppearance">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body: regular, dark grey -->
    <style name="TextAppearance.App.Body" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Supporting descriptions: smaller, muted -->
    <style name="TextAppearance.App.Caption" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Greeting: light weight, italic -->
    <style name="TextAppearance.App.Greeting" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Navigation labels -->
    <style name="TextAppearance.App.NavLabel" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Button text -->
    <style name="TextAppearance.App.Button" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ================= BUTTONS ================= -->

    <!-- Primary: near-black pill, white text -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary: soft grey pill, near-black text, no border -->
    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_secondary_bg</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/divider</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- For use on top of dark photos (onboarding): white pill, near-black text -->
    <style name="Widget.App.Button.OnDark" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/onboarding_button_bg</item>
        <item name="android:textColor">@color/onboarding_button_text</item>
        <item name="rippleColor">@color/divider</item>
    </style>

    <!-- Outlined white pill for dark photos -->
    <style name="Widget.App.Button.OnDarkOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/onboarding_text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="strokeColor">@color/onboarding_text_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- ================= INPUTS ================= -->
    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/text_muted</item>
    </style>

    <!-- Dropdowns look like inputs, with a chevron on the right -->
    <style name="Widget.App.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">48dp</item>
    </style>

    <!-- ================= CARDS ================= -->
    <!-- 24dp radius, no border, very soft diffused shadow -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_white</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/shadow_soft</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/shadow_soft</item>
    </style>

    <!-- ================= ICON BUTTONS ================= -->
    <!-- Look only. Give each one layout_width/layout_height="44dp" in the layout itself. -->
    <style name="Widget.App.IconButton.Dark" parent="">
        <item name="android:background">@drawable/bg_circle_icon_dark</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="Widget.App.IconButton.Light" parent="">
        <item name="android:background">@drawable/bg_circle_icon_light</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

</resources>