<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: light, minimalist, premium. Uses the system font. -->
    <style name="Base.Theme.MobileScholarSchool" parent="Theme.Material3.Light.NoActionBar">

        <!-- Brand colours -->
        <item name="colorPrimary">@color/text_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/card_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/accent_orange</item>
        <item name="android:colorBackground">@color/bg_main</item>

        <!-- Radio buttons, checkboxes, cursors: grey when off, near-black when on -->
        <item name="colorControlNormal">@color/text_muted</item>
        <item name="colorControlActivated">@color/text_primary</item>

        <!-- Window and system bars -->
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Default text colours: plain TextViews pick these up automatically -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>

        <!-- App-wide defaults for components -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="editTextStyle">@style/Widget.App.EditText</item>
        <item name="spinnerStyle">@style/Widget.App.Spinner</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
    </style>

    <style name="Theme.MobileScholarSchool" parent="Base.Theme.MobileScholarSchool" />
</resources>